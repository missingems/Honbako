(module
  ;; Read input descriptors only. This module has no network, file, cookie,
  ;; JavaScript or credential imports; all content URLs are developer-owned.
  (import "std" "buffer_len" (func $buffer_len (param i32) (result i32)))
  (import "std" "read_buffer" (func $read_buffer (param i32 i32 i32) (result i32)))
  (memory (export "memory") 2 2)
  (func (export "free_result") (param i32)) ;; fixed immutable result buffers
  (func $read (param $descriptor i32) (result i32) (local $len i32)
    (local.set $len (call $buffer_len (local.get $descriptor)))
    (if (i32.gt_u (local.get $len) (i32.const 8192)) (then (return (i32.const -1))))
    (if (i32.ne (call $read_buffer (local.get $descriptor) (i32.const 65536) (local.get $len)) (i32.const 0)) (then (return (i32.const -1))))
    (local.get $len))
  (func $key (param $descriptor i32) (param $key i32) (param $length i32) (result i32)
    (local $len i32) (local $i i32)
    (local.set $len (call $read (local.get $descriptor)))
    (if (i32.lt_s (local.get $len) (i32.add (local.get $length) (i32.const 1))) (then (return (i32.const 0))))
    (if (i32.ne (i32.load8_u (i32.const 65536)) (local.get $length)) (then (return (i32.const 0))))
    (block $done (loop $loop
      (br_if $done (i32.ge_u (local.get $i) (local.get $length)))
      (if (i32.ne (i32.load8_u (i32.add (i32.const 65537) (local.get $i))) (i32.load8_u (i32.add (local.get $key) (local.get $i)))) (then (return (i32.const 0))))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $loop)))
    (i32.const 1))
  (func $lower (param $c i32) (result i32)
    (if (result i32) (i32.and (i32.ge_u (local.get $c) (i32.const 65)) (i32.le_u (local.get $c) (i32.const 90)))
      (then (i32.add (local.get $c) (i32.const 32))) (else (local.get $c))))
  (func $query_matches (param $len i32) (result i32) (local $i i32) (local $j i32)
    (if (i32.eqz (local.get $len)) (then (return (i32.const 1))))
    (if (i32.gt_u (local.get $len) (i32.const 74)) (then (return (i32.const 0))))
    (block $done (loop $outer
      (br_if $done (i32.gt_u (i32.add (local.get $i) (local.get $len)) (i32.const 74)))
      (local.set $j (i32.const 0))
      (block $mismatch (loop $inner
        (if (i32.ge_u (local.get $j) (local.get $len)) (then (return (i32.const 1))))
        (br_if $mismatch (i32.ne
          (call $lower (i32.load8_u (i32.add (i32.const 65536) (local.get $j))))
          (i32.load8_u (i32.add (i32.const 3005) (i32.add (local.get $i) (local.get $j))))))
        (local.set $j (i32.add (local.get $j) (i32.const 1))) (br $inner)))
      (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $outer)))
    (i32.const 0))
  (func (export "get_search_manga_list") (param $query i32) (param $page i32) (param $filters i32) (result i32) (local $len i32)
    (if (i32.ne (local.get $page) (i32.const 1)) (then (return (i32.const 1512))))
    (local.set $len (call $read (local.get $query)))
    (if (i32.lt_s (local.get $len) (i32.const 0)) (then (return (i32.const -1))))
    (if (result i32) (call $query_matches (local.get $len)) (then (i32.const 1024)) (else (i32.const 1512))))
  (func (export "get_manga_list") (param $listing i32) (param $page i32) (result i32)
    (if (i32.eqz (call $key (local.get $listing) (i32.const 2996) (i32.const 9))) (then (return (i32.const -1))))
    (if (result i32) (i32.eq (local.get $page) (i32.const 1)) (then (i32.const 1024)) (else (i32.const 1512))))
  (func (export "get_manga_update") (param $manga i32) (param $details i32) (param $chapters i32) (result i32)
    (if (result i32) (call $key (local.get $manga) (i32.const 2968) (i32.const 15)) (then (i32.const 1528)) (else (i32.const -1))))
  (func (export "get_page_list") (param $manga i32) (param $chapter i32) (result i32)
    (if (result i32) (i32.and
      (call $key (local.get $manga) (i32.const 2968) (i32.const 15))
      (call $key (local.get $chapter) (i32.const 2983) (i32.const 13)))
      (then (i32.const 2016)) (else (i32.const -1))))
  (data (i32.const 1024) "\e5\01\00\00\e5\01\00\00\01\0f\62\6f\6f\6b\73\68\6f\70\2d\6f\6e\6c\69\6e\65\2d\54\68\65\20\42\6f\6f\6b\73\68\6f\70\20\42\65\74\77\65\65\6e\20\50\61\67\65\73\20\e2\80\94\20\4f\6e\6c\69\6e\65\20\45\64\69\74\69\6f\6e\01\41\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\63\6f\76\65\72\2e\70\6e\67\00\01\01\07\48\6f\6e\62\61\6b\6f\01\98\01\41\6e\20\6f\72\69\67\69\6e\61\6c\20\73\69\78\2d\70\61\67\65\20\48\6f\6e\62\61\6b\6f\20\73\74\6f\72\79\20\61\62\6f\75\74\20\61\20\62\6f\6f\6b\73\65\6c\6c\65\72\2c\20\61\20\63\75\72\69\6f\75\73\20\63\61\74\2c\20\61\6e\64\20\61\20\70\6c\61\63\65\20\74\6f\20\72\65\74\75\72\6e\2e\20\48\6f\73\74\65\64\20\62\79\20\74\68\65\20\61\70\70\20\64\65\76\65\6c\6f\70\65\72\20\66\6f\72\20\72\65\61\64\69\6e\67\20\61\6e\64\20\72\65\76\69\65\77\20\74\65\73\74\69\6e\67\2e\01\38\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\00\02\01\02\01\00\01\01\0d\66\69\72\73\74\2d\63\68\61\70\74\65\72\01\1a\54\68\65\20\42\6f\6f\6b\73\68\6f\70\20\42\65\74\77\65\65\6e\20\50\61\67\65\73\01\00\00\80\3f\00\00\00\01\38\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\01\02\65\6e\00\00\00")
  (data (i32.const 1512) "\0a\00\00\00\0a\00\00\00\00\00")
  (data (i32.const 1528) "\e3\01\00\00\e3\01\00\00\0f\62\6f\6f\6b\73\68\6f\70\2d\6f\6e\6c\69\6e\65\2d\54\68\65\20\42\6f\6f\6b\73\68\6f\70\20\42\65\74\77\65\65\6e\20\50\61\67\65\73\20\e2\80\94\20\4f\6e\6c\69\6e\65\20\45\64\69\74\69\6f\6e\01\41\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\63\6f\76\65\72\2e\70\6e\67\00\01\01\07\48\6f\6e\62\61\6b\6f\01\98\01\41\6e\20\6f\72\69\67\69\6e\61\6c\20\73\69\78\2d\70\61\67\65\20\48\6f\6e\62\61\6b\6f\20\73\74\6f\72\79\20\61\62\6f\75\74\20\61\20\62\6f\6f\6b\73\65\6c\6c\65\72\2c\20\61\20\63\75\72\69\6f\75\73\20\63\61\74\2c\20\61\6e\64\20\61\20\70\6c\61\63\65\20\74\6f\20\72\65\74\75\72\6e\2e\20\48\6f\73\74\65\64\20\62\79\20\74\68\65\20\61\70\70\20\64\65\76\65\6c\6f\70\65\72\20\66\6f\72\20\72\65\61\64\69\6e\67\20\61\6e\64\20\72\65\76\69\65\77\20\74\65\73\74\69\6e\67\2e\01\38\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\00\02\01\02\01\00\01\01\0d\66\69\72\73\74\2d\63\68\61\70\74\65\72\01\1a\54\68\65\20\42\6f\6f\6b\73\68\6f\70\20\42\65\74\77\65\65\6e\20\50\61\67\65\73\01\00\00\80\3f\00\00\00\01\38\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\01\02\65\6e\00\00")
  (data (i32.const 2016) "\b6\03\00\00\b6\03\00\00\06\00\42\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\70\61\67\65\2d\31\2e\70\6e\67\00\01\42\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\70\61\67\65\2d\31\2e\70\6e\67\00\01\0d\41\6e\20\45\6d\70\74\79\20\42\6f\6f\6b\00\42\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\70\61\67\65\2d\32\2e\70\6e\67\00\01\42\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\70\61\67\65\2d\32\2e\70\6e\67\00\01\11\41\20\4b\65\79\2c\20\4e\6f\74\20\61\20\42\6f\6f\6b\00\42\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\70\61\67\65\2d\33\2e\70\6e\67\00\01\42\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\70\61\67\65\2d\33\2e\70\6e\67\00\01\14\41\20\44\6f\6f\72\20\74\6f\20\59\6f\75\72\20\42\6f\6f\6b\73\00\42\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\70\61\67\65\2d\34\2e\70\6e\67\00\01\42\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e\67\69\74\68\75\62\2e\69\6f\2f\48\6f\6e\62\61\6b\6f\2f\6f\72\69\67\69\6e\61\6c\73\2f\62\6f\6f\6b\73\68\6f\70\2f\70\61\67\65\2d\34\2e\70\6e\67\00\01\12\4f\6e\65\20\50\61\67\65\20\61\74\20\61\20\54\69\6d\65\00\42\68\74\74\70\73\3a\2f\2f\6d\69\73\73\69\6e\67\65\6d\73\2e