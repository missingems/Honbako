// Sumi shares Aidoku's reader engine and keeps its own identity and iCloud store.
#include "Aidoku.xcconfig"
APP_ID_PREFIX = com.missingems
APP_ID_SUFFIX = honbaku
PRODUCT_BUNDLE_IDENTIFIER = $(APP_ID_PREFIX).$(APP_ID_SUFFIX)
ICLOUD_CONTAINER_ID = iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)
OTHER_SWIFT_FLAGS = $(inherited) -DSUMI
// Explicitly enabled only when building the owner's personal installation.
HONBAKO_PERSONAL_FEATURES = NO
// A separate explicit one-time setup request; regular owner launches need not import.
HONBAKO_IMPORT_ENGLISH_50 = NO
// Honbako installs its four complete localization tables in its own copy phase.
// Shared legacy localized display names must not override its app identity.
EXCLUDED_SOURCE_FILE_NAMES = $(inherited) InfoPlist.strings Localizable.strings Localizable.stringsdict
